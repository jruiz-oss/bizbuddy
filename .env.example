# ─── DATABASE ────────────────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/bizbuddy?sslmode=require

# ─── SESSION ─────────────────────────────────────────────────────────────────
# Long random string — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# ─── GOOGLE CLOUD STORAGE ─────────────────────────────────────────────────────
# Your Google Cloud project ID (used for GCS photo uploads)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# ─── VERCEL BLOB ─────────────────────────────────────────────────────────────
# From Vercel Dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ─── APP URL (Railway backend public URL) ────────────────────────────────────
# Set this on Railway after your first deploy — it's the Railway service URL
# e.g. https://bizbuddy-api.up.railway.app
APP_URL=https://your-railway-service.up.railway.app

# ─── FRONTEND URL (Vercel, for CORS) ─────────────────────────────────────────
# Set this on Railway — it's your Vercel deployment URL
# e.g. https://bizbuddy.vercel.app  (or your custom domain)
FRONTEND_URL=https://your-app.vercel.app

# ─── ANTHROPIC (set on Railway — used for review theme classification) ────────
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── VITE (frontend only — set on Vercel, not Railway) ───────────────────────
# Must be prefixed with VITE_ to be exposed to the browser bundle
# Set this on Vercel to the Railway backend URL above
VITE_API_URL=https://your-railway-service.up.railway.app
